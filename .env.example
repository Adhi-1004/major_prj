# Copy to .env and fill in. .env is git-ignored; this file is not.

# --- NVIDIA Active Speaker Detection (hosted NIM via NVCF) -------------------
# Create a key at https://build.nvidia.com/nvidia/active-speaker-detection
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Function id for the ASD function, shown on the model page's API tab.
ASD_FUNCTION_ID=00000000-0000-0000-0000-000000000000
ASD_TARGET=grpc.nvcf.nvidia.com:443

# --- Hugging Face (gated pyannote pipeline) ---------------------------------
# Read token from https://huggingface.co/settings/tokens
# You must ALSO accept the terms on the gated repo(s) — see README.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional tuning (defaults live in config/constants.py) -----------------
# WHISPER_MODEL=large-v3
# DEVICE=auto
# Spoken language: "en" (default), another ISO code such as "hi" or "fr",
# or "auto" to detect it. Set this for any non-English video.
# LANGUAGE=en
# LOG_LEVEL=INFO

# --- Getting past YouTube's bot wall ----------------------------------------
# "Sign in to confirm you're not a bot" is YouTube refusing an anonymous
# download. The defaults already try alternative player clients, which usually
# gets through. If it stops working, the reliable fix is to send cookies:
#
#   1. CLOSE your browser completely (it locks its own cookie database)
#   2. uncomment the line below
# YTDLP_COOKIES_FROM_BROWSER=chrome
#
# Or, if you cannot close the browser, export cookies.txt and point at it:
# YTDLP_COOKIE_FILE=cookies.txt
#
# Fastest escape hatch of all: download the video yourself and pass the file
# path instead of a URL. Local files never touch YouTube.
#
# YTDLP_PLAYER_CLIENTS=default,android_vr,android
