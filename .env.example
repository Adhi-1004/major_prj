# Copy to .env and fill in. .env is git-ignored; this file is not.

# --- NVIDIA Active Speaker Detection (hosted NIM via NVCF) -------------------
# Create a key at https://build.nvidia.com/nvidia/active-speaker-detection
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Function id for the ASD function, shown on the model page's API tab.
ASD_FUNCTION_ID=00000000-0000-0000-0000-000000000000
ASD_TARGET=grpc.nvcf.nvidia.com:443

# --- Hugging Face (gated pyannote pipeline) ---------------------------------
# Read token from https://huggingface.co/settings/tokens
# You must ALSO accept the terms on the gated repo(s) — see README.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional tuning (defaults live in config/constants.py) -----------------
# WHISPER_MODEL=large-v3
# DEVICE=auto
# LOG_LEVEL=INFO
